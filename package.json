{
  "name": "open-codenames",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --offline",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android --no-install",
    "typecheck": "tsc --noEmit",
    "logo:generate": "node scripts/generate-logo.cjs",
    "format": "prettier --write App.tsx src tests modules/offline-link/index.ts app.config.js plugins scripts/licenses.cjs",
    "format:check": "prettier --check App.tsx src tests modules/offline-link/index.ts app.config.js plugins scripts/licenses.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:android": "powershell -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "licenses": "node scripts/licenses.cjs",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "expo": "~54.0.38",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-font": "~14.0.12",
    "expo-keep-awake": "~15.0.8",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-qrcode-svg": "^6.3.27",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.14.0",
    "@types/react": "~19.1.10",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "vitest": "^5.0.5"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  }
}
